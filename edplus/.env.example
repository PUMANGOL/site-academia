DATABASE_URL=postgresql://postgres:postgres@localhost:5432/academia_pumangol
BETTER_AUTH_SECRET=replace-with-a-32-char-secret
BETTER_AUTH_URL=http://localhost:3000

# Email (Microsoft 365 via SMTP)
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=no.reply@pumangol.co.ao
SMTP_PASSWORD=
MAIL_FROM="Academia Pumangol <no.reply@pumangol.co.ao>"
# Link do formulário de feedback (ex.: Microsoft Forms). Sem valor, usa a página de contacto.
FEEDBACK_URL=

# RabbitMQ (fila de emails)
# Formato: amqp://<utilizador>:<password>@<host>:<porta>/<vhost>
# Em produção com TLS: amqps://<utilizador>:<password>@<host>:5671/<vhost>
RABBITMQ_URL=amqp://academia:academia@localhost:5672/academia
# Nome base da exchange e das filas (<base>, <base>.retry.*, <base>.failed)
RABBITMQ_EMAIL_QUEUE=academia.emails

# Worker de emails (bun run worker)
# true = escreve os emails no log em vez de os enviar (desenvolvimento)
MAIL_DRY_RUN=false
# Intervalo mínimo entre envios em ms (Microsoft 365: máx. 30/min)
MAIL_MIN_INTERVAL_MS=2000
# Hora (Africa/Luanda) das tarefas diárias: lembretes, feedback e limpeza
WORKER_DAILY_HOUR=8
# Porta do endpoint http://127.0.0.1:<porta>/health (0 = desligado)
WORKER_PORT=4100

# Imagens enviadas no backoffice (notícias, páginas). Em produção use um volume persistente.
UPLOAD_DIR=./storage/uploads
# Tamanho máximo por imagem, em MB
MEDIA_MAX_MB=5

# Caixa da Academia que recebe os pedidos de empresas (página Parceiros)
ACADEMY_INBOX_EMAIL=academia@pumangol.co.ao
